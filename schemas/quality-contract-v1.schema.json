{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavatrix.com/schemas/quality-contract-v1.schema.json",
  "title": "Weavatrix Quality contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["quality_contract_v", "change", "requirements"],
  "properties": {
    "quality_contract_v": { "const": 1 },
    "change": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planning_tokens": { "type": "integer", "minimum": 0 },
        "runtime_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "requirement", "scenarios"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "obligations"],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dimensions": { "type": "object" },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "array", "items": { "$ref": "#/$defs/evidence_kind" } },
            "on_failure": { "type": "array", "items": { "$ref": "#/$defs/evidence_kind" } }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "behavioral",
            "invariant",
            "api",
            "contract",
            "permission",
            "accessibility",
            "visual",
            "performance",
            "architecture",
            "code_health",
            "coverage",
            "mutation",
            "metamorphic",
            "security_policy"
          ]
        }
      }
    },
    "evidence_kind": {
      "enum": ["dom", "network", "screenshot", "trace", "har", "console", "storage", "coverage"]
    }
  }
}
