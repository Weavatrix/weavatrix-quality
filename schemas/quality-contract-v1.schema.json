{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://weavatrix.com/schemas/quality-contract-v1.schema.json",
  "title": "Weavatrix Quality contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["quality_contract_v", "change", "requirements"],
  "properties": {
    "quality_contract_v": { "const": 1 },
    "change": { "type": "string", "minLength": 1 },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": { "enum": ["low", "medium", "high", "critical"] }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/requirement" }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "planning_tokens": { "type": "integer", "minimum": 0 },
        "runtime_tokens": { "type": "integer", "minimum": 0 }
      }
    }
  },
  "$defs": {
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability", "requirement", "scenarios"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "requirement": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      }
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario", "obligations"],
      "properties": {
        "scenario": { "type": "string", "minLength": 1 },
        "actors": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": { "type": "array", "items": { "type": "string" } },
            "exclude": { "type": "array", "items": { "type": "string" } }
          }
        },
        "dimensions": { "type": "object" },
        "obligations": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/obligation" }
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "required": { "type": "array", "items": { "$ref": "#/$defs/evidence_kind" } },
            "on_failure": { "type": "array", "items": { "$ref": "#/$defs/evidence_kind" } }
          }
        },
        "mutation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "operators": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "behavioral",
            "invariant",
            "api",
            "contract",
            "permission",
            "accessibility",
            "visual",
            "performance",
            "architecture",
            "code_health",
            "coverage",
            "mutation",
            "metamorphic",
            "security_policy"
          ]
        },
        "condition": { "$ref": "#/$defs/predicate" },
        "expected": { "$ref": "#/$defs/predicate" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "minLength": 1 },
        "accessible_name": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "test_id": { "type": "string", "minLength": 1 },
        "fallback_css": { "type": "string", "minLength": 1 },
        "scope": { "$ref": "#/$defs/target" }
      },
      "anyOf": [
        { "required": ["role"] },
        { "required": ["accessible_name"] },
        { "required": ["label"] },
        { "required": ["test_id"] },
        { "required": ["fallback_css"] }
      ]
    },
    "predicate": {
      "oneOf": [
        { "$ref": "#/$defs/target_predicate" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "target", "value"],
          "properties": {
            "kind": { "enum": ["text_equals", "text_contains", "value_equals"] },
            "target": { "$ref": "#/$defs/target" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "enum": ["route_equals", "route_contains"] },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "url_contains"],
          "properties": {
            "kind": { "const": "network_response" },
            "method": { "type": "string", "minLength": 1 },
            "url_contains": { "type": "string", "minLength": 1 },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "no_console_errors" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "area", "key", "value"],
          "properties": {
            "kind": { "const": "storage_equals" },
            "area": { "enum": ["local", "session"] },
            "key": { "type": "string", "minLength": 1 },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "area", "key"],
          "properties": {
            "kind": { "const": "storage_absent" },
            "area": { "enum": ["local", "session"] },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "status"],
          "properties": {
            "kind": { "const": "api_status" },
            "operation": { "type": "string", "minLength": 1 },
            "status": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "operation", "pointer", "value"],
          "properties": {
            "kind": { "const": "api_json_equals" },
            "operation": { "type": "string", "minLength": 1 },
            "pointer": { "type": "string" },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "predicates"],
          "properties": {
            "kind": { "enum": ["all", "any"] },
            "predicates": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/$defs/predicate" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "predicate"],
          "properties": {
            "kind": { "const": "not" },
            "predicate": { "$ref": "#/$defs/predicate" }
          }
        }
      ]
    },
    "target_predicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "target"],
      "properties": {
        "kind": { "enum": ["visible", "hidden", "enabled", "disabled"] },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "evidence_kind": {
      "enum": ["dom", "network", "screenshot", "trace", "har", "console", "storage", "coverage"]
    }
  }
}
