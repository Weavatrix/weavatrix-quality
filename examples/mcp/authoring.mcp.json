{
  "mcpServers": {
    "wvq-authoring": {
      "command": "npx",
      "args": [
        "-y",
        "@weavatrix/wvq@0.1.0-alpha.2",
        "mcp",
        "--repo",
        "/REPLACE/WITH/ABSOLUTE/PATH/TO/REPO",
        "--profile",
        "authoring",
        "--change",
        "current",
        "--base",
        "origin/main",
        "--head",
        "WORKTREE"
      ]
    }
  }
}
